{
  "name": "job-aggregator-api",
  "version": "1.0.0",
  "description": "REST API for a job aggregator: recent listings from public job APIs, with honest posting dates and eligibility",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/Gbolahan007/job-aggregator.git",
    "directory": "api"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test",
    "build": "tsc",
    "start": "node dist/server.js",
    "migrate": "tsx src/db/migrate.ts",
    "ingest": "tsx src/cli/ingest.ts",
    "test": "tsx --test test/unit/*.test.ts",
    "test:db": "tsx --test --test-concurrency=1 test/db/*.test.ts"
  },
  "keywords": [],
  "author": "Gbolahan Lawal",
  "license": "UNLICENSED",
  "type": "module",
  "dependencies": {
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
